---
import { Picture } from "astro:assets";

type Props = {
  imageMetadata: ImageMetadata;
  alt: string;
};

const { imageMetadata, alt } = Astro.props;
---

<figure class="flex flex-col items-center justify-center">
  <Picture
    src={imageMetadata}
    alt={alt}
    class="rounded-box"
    formats={["avif", "webp"]}
    decoding="async"
    loading="lazy"
  />
  <figcaption class="text-base-content/80 mt-2 text-sm italic">{alt}</figcaption>
</figure>
