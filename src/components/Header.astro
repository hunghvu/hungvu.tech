---
import { BASE_SITE_NAME, GITHUB_URL, LINKEDIN_URL } from "../consts";
import Icon from "./Icon.astro";
import Search from "./Search.astro";
---

<header class="daisyui-navbar bg-base-100 max-w-(--breakpoint-xl) mx-auto px-4">
  <nav class="daisyui-navbar-start">
    <div class="daisyui-dropdown lg:hidden">
      <button class="daisyui-btn daisyui-btn-ghost daisyui-btn-circle" aria-label="Open menu">
        <Icon name="hamburger" class="h-5 w-5" />
      </button>
      <ul
        class="daisyui-menu daisyui-dropdown-content daisyui-menu-sm rounded-box bg-base-100 z-1 mt-3 w-52 p-2 shadow-sm"
      >
        <li><a href="/">Home</a></li>
        <div class="daisyui-divider my-2"></div>
        <li class="daisyui-menu-title text-xs opacity-50">Connect</li>
        <li><a href={LINKEDIN_URL} target="_blank">LinkedIn</a></li>
        <li><a href={GITHUB_URL} target="_blank">GitHub</a></li>
        <li><a href={`${Astro.site}/rss.xml`}>RSS Feed</a></li>
      </ul>
    </div>
    <a href="/" class="daisyui-btn daisyui-btn-ghost text-xl">{BASE_SITE_NAME}</a>
  </nav>
  <nav class="daisyui-navbar-center hidden lg:flex">
    <ul class="daisyui-menu daisyui-menu-horizontal px-1">
      <li><a href="/">Home</a></li>
    </ul>
  </nav>
  <div class="daisyui-navbar-end gap-1">
    <a
      href={LINKEDIN_URL}
      target="_blank"
      class="daisyui-btn daisyui-btn-ghost daisyui-btn-circle hidden sm:inline-flex"
    >
      <span class="sr-only">Visit LinkedIn page.</span>
      <Icon name="linkedin" class="fill-base-content" width="20" height="20" />
    </a>
    <a
      href={GITHUB_URL}
      target="_blank"
      class="daisyui-btn daisyui-btn-ghost daisyui-btn-circle hidden sm:inline-flex"
    >
      <span class="sr-only">Visit GitHub profile.</span>
      <Icon name="github" class="fill-base-content" width="20" height="20" />
    </a>
    <a
      href={`${Astro.site}/rss.xml`}
      class="daisyui-btn daisyui-btn-ghost daisyui-btn-circle hidden sm:inline-flex"
    >
      <span class="sr-only">Visit RSS feed.</span>
      <Icon name="rss" class="fill-base-content" width="20" height="20" />
    </a>
    <button
      class="daisyui-btn daisyui-btn-ghost daisyui-btn-circle"
      onclick="document.getElementById('search-modal').showModal()"
      aria-label="Open search"
    >
      <Icon name="search" class="h-5 w-5" />
    </button>
    <label class="daisyui-btn daisyui-btn-ghost daisyui-btn-circle daisyui-swap daisyui-swap-rotate">
      <span class="sr-only">Choose theme preference: Light or dark mode.</span>
      <input type="checkbox" data-toggle-theme="dark" aria-label="Toggle theme" />
      <Icon name="sun" class="daisyui-swap-off fill-base-content" width="20" height="20" />
      <Icon name="moon" class="daisyui-swap-on fill-base-content" width="20" height="20" />
    </label>
  </div>
  <Search />
</header>
