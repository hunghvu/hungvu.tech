---
import { BASE_SITE_NAME, GITHUB_URL, LINKEDIN_URL } from "../consts";
import Icon from "./Icon.astro";
---

<header class="daisyui-navbar bg-base-100 max-w-(--breakpoint-xl)">
  <nav class="daisyui-navbar-start">
    <div class="daisyui-dropdown">
      <div tabindex="0" role="button" class="daisyui-btn daisyui-btn-ghost lg:hidden">
        <Icon name="hamburger" class="h-5 w-5" />
      </div>
      <ul
        class="daisyui-menu daisyui-dropdown-content daisyui-menu-sm rounded-box bg-base-100 z-1 mt-3 w-52 p-2 shadow-sm"
      >
        <li><a href="/">Home</a></li>
      </ul>
    </div>
    <a href="/" class="daisyui-btn daisyui-btn-ghost text-xl">{BASE_SITE_NAME}</a>
  </nav>
  <nav class="daisyui-navbar-center hidden lg:flex">
    <ul class="daisyui-menu daisyui-menu-horizontal px-1">
      <li><a href="/">Home</a></li>
    </ul>
  </nav>
  <div class="daisyui-navbar-end gap-4">
    <a href={LINKEDIN_URL} target="_blank">
      <span class="hidden">Visit LinkedIn page.</span>
      <Icon name="linkedin" class="fill-base-content" width="24" height="24" />
    </a>
    <a href={GITHUB_URL} target="_blank">
      <span class="hidden">Visit GitHub profile.</span>
      <Icon name="github" class="fill-base-content" width="24" height="24" />
    </a>
    <a href={`${Astro.site}/rss.xml`}>
      <span class="hidden">Visit RSS feed.</span>
      <Icon name="rss" class="fill-base-content" width="24" height="24" />
    </a>
    <label class="daisyui-swap daisyui-swap-rotate">
      <span class="hidden">Choose theme preference: Light or dark mode.</span>
      <input type="checkbox" data-toggle-theme="dark" />
      <Icon name="sun" class="daisyui-swap-off fill-base-content" width="24" height="24" />
      <Icon name="moon" class="daisyui-swap-on fill-base-content" width="24" height="24" />
    </label>
  </div>
</header>
