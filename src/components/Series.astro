---
import { getCollection } from "astro:content";

type Props = { series: string };
const { series } = Astro.props;
const posts = await getCollection("blog");
const postsInTheSameSeries = posts
  .filter((post) => post.data.series === series)
  .sort(
    // Latest post first
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  );
---

<div class="daisyui-card bg-base-300 rounded-box w-full">
  <div class="p-4 pb-2">
    <h2 class="text-sm font-bold tracking-wider uppercase opacity-60">Series: {series}</h2>
  </div>
  <div class="daisyui-divider my-0 h-px px-4"></div>
  <div class="h-64 overflow-y-scroll p-2">
    <ul class="daisyui-menu daisyui-menu-sm">
      {
        postsInTheSameSeries.map((post, index) => (
          <li>
            <a href={`/${post.id}`} class="flex items-start gap-3">
              <span class="tabular-nums opacity-70">{postsInTheSameSeries.length - index}.</span>
              <span>{post.data.readerTitle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
