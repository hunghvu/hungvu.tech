---
import { GITHUB_URL, LINKEDIN_URL, SITE_OWNER_NAME } from "../consts";
import Icon from "./Icon.astro";
---

<footer
  class="daisyui-footer daisyui-footer-vertical sm:daisyui-footer-horizontal max-w-(--breakpoint-xl) self-center px-6 py-16"
>
  <aside class="flex h-full w-full flex-row items-center justify-center sm:justify-start">
    <p class="text-center">
      Copyright &copy; {new Date().getFullYear()}
      {SITE_OWNER_NAME} - All right reserved
    </p>
  </aside>
  <nav class="flex w-full flex-row justify-center gap-4 sm:justify-end">
    <a href={LINKEDIN_URL} target="_blank">
      <span class="sr-only">Visit LinkedIn page.</span>
      <Icon name="linkedin" class="fill-base-content" width="24" height="24" />
    </a>
    <a href={GITHUB_URL} target="_blank">
      <span class="sr-only">Visit GitHub profile.</span>
      <Icon name="github" class="fill-base-content" width="24" height="24" />
    </a>
    <a href={`${Astro.site}/rss.xml`}>
      <span class="sr-only">Visit RSS feed.</span>
      <Icon name="rss" class="fill-base-content" width="24" height="24" />
    </a>
    <a href={`${Astro.site}/sitemap-index.xml`}>
      <span class="sr-only">Visit sitemap.</span>
      <Icon name="sitemap" class="fill-base-content" width="24" height="24" />
    </a>
  </nav>
</footer>
