---
import { BASE_SITE_NAME, BASE_SITE_DESCRIPTION } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
---

<BaseLayout seoTitle={BASE_SITE_NAME} seoDescription={BASE_SITE_DESCRIPTION}>
  <div
    class="prose prose-sm sm:prose-base lg:prose-lg dark:prose-invert prose-code:before:content-none prose-code:after:content-none flex w-full flex-col items-center"
  >
    <!-- An open-source static page, no worry about leaking sensitive information. -->
    <h1>500: {error instanceof Error ? error.message : "Unknown error"}</h1>
    <p>
      <a href="https://github.com/hunghvu/hungvu.tech/issues">Report bug on Github</a> or <a
        href="/">Return to home page</a
      >
    </p>
  </div>
</BaseLayout>
